# Copy to `.env` and fill in real values. Never commit `.env`.
# Agronova currently has NO configured backend; these are the names the
# auth service (src/services/auth.ts) will read once a provider is connected.

# Base URL of the authentication / API backend (leave empty for demo mode)
VITE_API_BASE_URL=

# Public (browser-safe) keys only. Never put service-role keys or secrets here:
# anything prefixed with VITE_ is bundled into the public JavaScript.
VITE_AUTH_PUBLIC_KEY=
